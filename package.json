{
  "name": "portfolioforge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:unit": "vitest run",
    "test:integration": "playwright test --project=chromium tests/integration",
    "test": "npm run test:unit && npm run test:integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "seed:fx": "node --env-file=.env.local --import tsx src/scripts/seed-fx.ts",
    "seed:instruments": "node --env-file=.env.local --import tsx src/scripts/seed-instruments.ts",
    "seed:stooq": "node --env-file=.env.local --import tsx src/scripts/seed-instruments-stooq.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.101.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eodhd": "^1.0.0",
    "lucide-react": "^1.7.0",
    "next": "16.2.2",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.1.2",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "yahoo-finance2": "^3.14.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
